---
const services = [
	{
		label: 'Order Fulfillment',
		image: '/packing.jpg',
		p1: 'Every order is picked, packed, and shipped from our network within hours of coming in, with real-time tracking from cart to doorstep.',
		p2: 'We plug directly into your storefront, so orders flow in and tracking numbers flow back out without anyone touching a spreadsheet.',
	},
	{
		label: 'Storage Warehousing',
		image: '/man-forklift.jpg',
		p1: 'Climate-controlled, secure facilities scale with your inventory, whether that is a hundred units or a hundred thousand.',
		p2: 'Live stock counts and a dashboard view of every SKU mean you always know exactly what you have and where it sits.',
	},
	{
		label: 'Cross Docking',
		image: '/container.webp',
		p1: 'Inbound shipments move straight to outbound transport with minimal handling, cutting storage time and cost.',
		p2: 'Ideal for high-turnover goods, cross docking keeps product moving instead of sitting on a shelf.',
	},
	{
		label: 'Additional Services',
		image: '/packing.jpg',
		p1: 'Kitting, custom packaging, returns processing, and quality checks are all handled under one roof.',
		p2: 'Tell us what your logistics need looks like and we will build a workflow around it, not the other way around.',
	},
]
---
	
<div class="flex-col p4 g4 outline">
	<div class="flex-col">
		<h2>Warehousing and delivery —</h2>
		<h2>Working together as one system</h2>
	</div>
	<div class="flex" id="service-tabs">
		{
			services.map((service, i) => (
				<div
					class="grow service-tab mr05 pt2"
					class:list={{ selected: i === 0 }}
					data-image={service.image}
					data-p1={service.p1}
					data-p2={service.p2}
				>
					<h5 style="width: min-content;">{service.label}</h5>
				</div>
			))
		}
	</div>
	<div class="parallax-frame" style="width: 100%; aspect-ratio:2.5/1; overflow: hidden; position: relative;">
		<div class="service-image-slot" id="service-image-slot-a" style="position: absolute; inset: 0; overflow: hidden;">
			<img
				class="parallax-image"
				src={services[0].image}
				alt="Desktop showing a WMS system in a warehouse"
				style="object-fit: cover; height:130%; width:100%"
			/>
		</div>
		<div class="service-image-slot" id="service-image-slot-b" style="position: absolute; inset: 0; overflow: hidden; transform: translateY(-100%);">
			<img
				class="parallax-image"
				src={services[0].image}
				alt="Desktop showing a WMS system in a warehouse"
				style="object-fit: cover; height:130%; width:100%"
			/>
		</div>
	</div>
	<div class="flex g2">
		<p id="service-p1">{services[0].p1}</p>
		<p id="service-p2">{services[0].p2}</p>
	</div>
</div>

<script>
	import gsap from 'gsap'

	const tabs = gsap.utils.toArray('.service-tab') as HTMLElement[]
	const slotA = document.getElementById('service-image-slot-a')
	const slotB = document.getElementById('service-image-slot-b')
	const p1 = document.getElementById('service-p1')
	const p2 = document.getElementById('service-p2')

	if (tabs.length && slotA && slotB && p1 && p2) {
		let active = slotA
		let staged = slotB

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				if (tab.classList.contains('selected')) return

				tabs.forEach((t) => t.classList.remove('selected'))
				tab.classList.add('selected')

				staged.querySelector('img')!.src = tab.dataset.image!
				gsap.set(staged, { y: '-100%' })

				gsap
					.timeline({ defaults: { overwrite: true } })
					.to([active, staged], { y: (i) => (i === 0 ? '100%' : '0%'), duration: 0.6, ease: 'power3.inOut' }, 0)
					.to([p1, p2], { y: 8, opacity: 0, duration: 0.2, ease: 'power1.in' }, 0)
					.call(() => {
						p1.textContent = tab.dataset.p1!
						p2.textContent = tab.dataset.p2!
					}, undefined, 0.2)
					.fromTo([p1, p2], { y: -8, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: 'power2.out' }, 0.35)

				const next = active
				active = staged
				staged = next
			})
		})
	}
</script>

<style>
	.service-tab {
		cursor: pointer;
		border-top: 1px solid hsl(0, 0%, 90%);
	}
	.service-tab.selected {
		border-top-color: black;
	}
</style>
