---
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Subhero from '../components/Subhero.astro'
import Benefits from '../components/Benefits.astro'
import ServiceSelect from '../components/ServiceSelect.astro'
import FAQ2 from '../components/FAQ2.astro'
import 'lenis/dist/lenis.css'
import '../css/reset.css'
import '../css/type.css'
import '../css/structure.css'
import '../css/utils.css'
import '../css/breakpoints.css'
---

<html lang="en">
	<head>
		<title>EFC - Home</title>
		<meta charset="utf-8" />
		<link rel="icon" href="/icon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Header />
		<div class="px4 flex-col">
			<Hero />
			<Subhero />
			<Benefits />
			<ServiceSelect />
			<FAQ2/>
		</div>
	</body>
</html>

<script>
	import '../scripts/scroll.js'
	import { initParallax } from '../scripts/parallax.js'

	initParallax()
</script>
