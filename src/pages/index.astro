---
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Subhero from '../components/Subhero.astro'
import Benefits from '../components/Benefits.astro'
import ServiceSelect from '../components/ServiceSelect.astro'
import FAQ from '../components/FAQ.jsx'
import 'lenis/dist/lenis.css'
---

<html lang="en">
	<head>
		<title>EFC - Home</title>
		<meta charset="utf-8" />
		<link rel="icon" href="/icon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<!--  -->
		<link rel="stylesheet" href="src/css/reset.css" />
		<link rel="stylesheet" href="src/css/type.css" />
		<link rel="stylesheet" href="src/css/structure.css" />
		<link rel="stylesheet" href="src/css/utils.css" />
		<link rel="stylesheet" href="src/css/breakpoints.css" />
	</head>
	<body>
		<Header />
		<div class="px4 flex-col">
			<Hero />
			<Subhero />
			<Benefits />
			<ServiceSelect />
			<FAQ />
		</div>
	</body>
</html>

<script>
	import '../scripts/scroll.js'
	import { fadeUp } from '../scripts/animations.js'
	import { collapseLogoOnScroll } from '../scripts/header.js'
	import { initParallax } from '../scripts/parallax.js'

	document.querySelectorAll('.scroll-target').forEach((el) => fadeUp(el))
	collapseLogoOnScroll()
	initParallax()
</script>
